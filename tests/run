#!/bin/sh
# Tests the relay end to end: brings up a real one on a spare port, with its data
# in a temporary directory, and walks the whole path -- log in, pair, send
# position, wait for a command and receive it.
#
# Nothing is simulated. It is the binary that gets deployed, talking HTTP to
# itself, because what can fail here are the seams and not the functions.
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$HERE/.."
DATA="$(mktemp -d)"
PORT="${PORT:-8477}"
KEY=testtesttest

[ -x "$ROOT/lost-phone-relay" ] || { echo "compile first: ./build" >&2; exit 1; }

"$ROOT/lost-phone-relay" -addr "127.0.0.1:$PORT" -data "$DATA" -password "$KEY" \
	> "$DATA/relay.log" 2>&1 &
RELAY=$!
trap 'kill $RELAY 2>/dev/null; rm -rf "$DATA"' EXIT
sleep 1

# HTTPS, which is how it really serves: the relay generates its own certificate
# on startup. What is tested is what is sent, not a more convenient variant -- if
# these tests spoke plain HTTP, they would cover neither the certificate
# generation nor the TLS path everything goes through.
B="https://127.0.0.1:$PORT"

# -k because the certificate is self-signed ON PURPOSE. The one that really
# verifies the fingerprint is the phone, and that is tested on the device: here
# there is nothing to gain from validating a chain that by design does not exist.
curl() { command curl -k "$@"; }
C="$DATA/cookies"
failures=0
check() {
	if [ "$2" = "$3" ]; then
		echo "  ok     $1"
	else
		echo "  FAIL   $1 (expected '$3', got '$2')"
		failures=$((failures + 1))
	fi
}

echo "--- its own certificate ---"
# Without this, TLS would be a claim in the README. That the file exists and that
# the fingerprint shows in the log is what lets the phone pin it when pairing.
check "generates its certificate" "$([ -f "$DATA/cert.pem" ] && echo yes || echo no)" "yes"
check "and its private key"       "$([ -f "$DATA/key.pem" ] && echo yes || echo no)" "yes"
check "the private key is not readable by anyone else" \
	"$(stat -c %a "$DATA/key.pem" 2>/dev/null)" "600"
check "reports the fingerprint in the log" \
	"$(grep -c "SHA-256 fingerprint" "$DATA/relay.log" 2>/dev/null || echo 0)" "1"

# Reusing and not regenerating matters: a new certificate on every startup would
# break the phone's pin on every restart of the server, and the symptom would be
# a phone that "suddenly" stops connecting.
FP1="$(grep -A1 "SHA-256 fingerprint" "$DATA/relay.log" | tail -1 | grep -oE "[0-9A-F:]{95}")"
"$ROOT/lost-phone-relay" -addr "127.0.0.1:$((PORT + 1))" -data "$DATA" \
	-password "$KEY" > "$DATA/relay2.log" 2>&1 &
SECOND=$!
sleep 1
FP2="$(grep -A1 "SHA-256 fingerprint" "$DATA/relay2.log" | tail -1 | grep -oE "[0-9A-F:]{95}")"
kill $SECOND 2>/dev/null
check "reuses the certificate across restarts" \
	"$([ -n "$FP1" ] && [ "$FP1" = "$FP2" ] && echo yes || echo no)" "yes"

echo "--- the panel is closed until you log in ---"
check "without a session no phones are listed" \
	"$(curl -s -o /dev/null -w '%{http_code}' $B/api/devices)" "401"
check "a bad password does not get in" \
	"$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/api/login -d '{"password":"noesa"}')" "401"
check "the good one does" \
	"$(curl -s -c $C -o /dev/null -w '%{http_code}' -X POST $B/api/login -d "{\"password\":\"$KEY\"}")" "200"

# NOBODY CAN LOCK YOU OUT OF YOUR OWN PANEL.
#
# This had a one-minute lockout after five failures, and it was a mistake: the
# counter was global, so anyone who reached the panel could lock the owner out by
# failing five times a minute -- exactly the day they have lost the phone. A
# protection an attacker can aim at you is a weapon.
#
# Now the failures only DELAY the response. The good password always gets in, come
# whatever failures may. If someone brings the lockout back, this goes red.
echo "--- failing a lot does not lock the owner out of the panel ---"
i=0
while [ $i -lt 8 ]; do
	curl -s -o /dev/null -X POST $B/api/login -d '{"password":"tampocoesa"}' || true
	i=$((i + 1))
done
check "after eight failures, the good password still gets in" \
	"$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/api/login -d "{\"password\":\"$KEY\"}")" "200"
check "and the bad one still does not get in" \
	"$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/api/login -d '{"password":"noesa"}')" "401"

echo "--- the pairing ---"
COD=$(curl -s -b $C -X POST $B/api/pair -d '{}' | sed 's/.*"code":"\([^"]*\)".*/\1/')
# Four DIGITS, not ten alphanumeric characters. This is typed once, on a phone,
# looking from one screen to another. If someone lengthens it "for security",
# this goes red: what protects the pairing is that it expires in ten minutes and
# dies on the third failure, not the length.
check "the code has four characters" "$(printf %s "$COD" | wc -c | tr -d ' ')" "4"
check "and they are all digits" "$(printf %s "$COD" | tr -d '0-9' | wc -c | tr -d ' ')" "0"
check "a wrong code does not pair" \
	"$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/api/device/pair -d '{"codigo":"xxxxxxxxxx"}')" "401"

# In uppercase and with spaces: it is what a stranger's phone keyboard sends.
RESP=$(curl -s -X POST $B/api/device/pair \
	-d "{\"codigo\":\" $(echo "$COD" | tr a-z A-Z) \",\"name\":\"surya\"}")
TOK=$(echo "$RESP" | sed 's/.*"token":"\([^"]*\)".*/\1/')
check "the code works even if it arrives in uppercase and with spaces" \
	"$([ -n "$TOK" ] && echo yes || echo no)" "yes"
check "and it does not work a second time" \
	"$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/api/device/pair -d "{\"codigo\":\"$COD\"}")" "401"

echo "--- position and commands ---"
check "the phone can send its position" \
	"$(curl -s -o /dev/null -w '%{http_code}' -X POST $B/api/device/report -H "Authorization: Bearer $TOK" \
		-d '{"tiene_coordenadas":true,"latitud":40.41678,"longitud":-3.70379,"precision_metros":18,"origen":"gnss","bateria":43}')" "200"
ID=$(curl -s -b $C $B/api/devices | sed 's/.*"id":"\([^"]*\)".*/\1/' | head -1)
check "and the panel sees it" "$([ -n "$ID" ] && echo yes || echo no)" "yes"

# The phone waits; the panel sends. It has to arrive at once, not when the long
# wait ends: if it took the whole minute, the long polling would be worthless.
( curl -s -m 20 $B/api/device/poll -H "Authorization: Bearer $TOK" > "$DATA/command.json" ) &
POLL=$!
sleep 1
# Sent with the OLD key and the OLD verb on purpose: that is what a phone or a
# script from before the rename does, and the relay has to keep taking it. The
# key is translated, the verb is not -- the daemon answers to both.
curl -s -b $C -o /dev/null -X POST $B/api/command -d "{\"id\":\"$ID\",\"orden\":\"sonar\"}"
wait $POLL
check "a command sent with the old key reaches the phone" \
	"$(grep -c '"command":"sonar"' "$DATA/command.json" || true)" "1"
# A second wait comes up with nothing and times out. The BODY is checked, not the
# HTTP code: curl returns '000' on timeout, which says the same thing worse.
check "and it is not delivered twice" \
	"$(curl -s -m 5 $B/api/device/poll -H "Authorization: Bearer $TOK" | grep -c command || true)" "0"
# And the same thing with the English key and verb, which is what 1.2 sends.
( curl -s -m 20 $B/api/device/poll -H "Authorization: Bearer $TOK" > "$DATA/command-en.json" ) &
POLL2=$!
sleep 1
curl -s -b $C -o /dev/null -X POST $B/api/command -d "{\"id\":\"$ID\",\"command\":\"ring\"}"
wait $POLL2
check "and one sent with the new key does too" \
	"$(grep -c '"command":"ring"' "$DATA/command-en.json" || true)" "1"
check "a made-up command is rejected" \
	"$(curl -s -o /dev/null -w '%{http_code}' -b $C -X POST $B/api/command -d "{\"id\":\"$ID\",\"orden\":\"formatear\"}")" "400"
# The remote power-off has to keep existing here. The one that decides whether to
# obey is the phone -- it comes powered off and only accepts it over this channel
# -- but if someone removes it from the list of valid commands, the panel button
# stops working and it is not discovered until the day it is needed.
check "the relay forwards the power-off" \
	"$(curl -s -o /dev/null -w '%{http_code}' -b $C -X POST $B/api/command -d "{\"id\":\"$ID\",\"orden\":\"apagar\"}")" "200"

echo "--- the map ---"
# That the map is NOT an open tile proxy: without the panel's session, anyone
# could spend the bandwidth of whoever hosts this.
check "without a session there is no map" \
	"$(curl -s -o /dev/null -w '%{http_code}' "$B/api/map?lat=37.5&lon=-1.3")" "401"
check "impossible coordinates are rejected" \
	"$(curl -s -o /dev/null -w '%{http_code}' -b $C "$B/api/map?lat=999&lon=-1.3")" "400"
# The real map needs to reach the internet, so it cannot be a failure of the
# test suite: it is reported and skipped. A 502 here means "this computer does not
# reach OSM", not "the program is broken".
MAPA=$(curl -s -o "$DATA/map.png" -w '%{http_code}' -b $C \
	"$B/api/map?lat=37.56620&lon=-1.30361&precision=20")
if [ "$MAPA" = "200" ]; then
	check "the map arrives and is a PNG" \
		"$(head -c 4 "$DATA/map.png" | od -An -tx1 | tr -d ' ')" "89504e47"
else
	echo "  --     no internet to OSM ($MAPA): cannot test the real map"
fi

echo "--- the two credentials do not mix ---"
check "the phone's token does not open the panel" \
	"$(curl -s -o /dev/null -w '%{http_code}' $B/api/devices -H "Authorization: Bearer $TOK")" "401"
check "the panel's session does not work as a token" \
	"$(curl -s -o /dev/null -w '%{http_code}' -b $C $B/api/device/poll)" "401"

echo
if [ "$failures" -eq 0 ]; then
	echo "== all green =="
else
	echo "== $failures failures =="
	exit 1
fi

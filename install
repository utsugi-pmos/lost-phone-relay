#!/bin/sh
# Assistant to set up the relay wherever you please.
#
#     ./install                 right here
#     ./install --at user@machine[:ssh-port]
#
# Without asking anything, for scripts and to be able to test it:
#
#     ./install --port 8477
#     ./install --port 8477 --cert /path/fullchain.pem --key /path/privkey.pem
#
# And to undo it, because an installer with no way back is a trap:
#
#     ./install --remove [--at user@machine]
#
# It exists because without it this directory is a README and a binary, and "set it up"
# is not an instruction. The rest of the project installs itself from surya-setup;
# this piece cannot be the exception, because it is precisely the one you need
# when the phone is out on the street.
#
# WHAT IT ASKS, AND WHY SO LITTLE
#
# The port, and whether you already have a certificate. Nothing more. Each extra question is
# someone who gives up halfway and is left with no way to find their phone.
# The password is generated by it, because one you pick in a hurry is "1234".
#
# WHAT IT DOES NOT DO, ON PURPOSE
#
# It does not touch your DNS, does not create subdomains, does not open ports on your router and does not install
# certificates. It tells you what is missing and you decide: it is your machine.
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
REMOTE=""
SSH_PORT=22
# Empty = they have to be asked. If they come by flag nothing is asked, which
# is what lets you drop this into a script -- and, above all, TEST IT: an
# installer that can only be run by hand is an installer nobody runs
# until it is needed.
PORT=""
CERT=""
KEY=""
NO_PROMPTS=""
REMOVE=""

while [ $# -gt 0 ]; do
	case "$1" in
		--at|--en)
			[ $# -ge 2 ] || { echo "usage: $0 --at user@machine[:port]" >&2; exit 1; }
			REMOTE="${2%%:*}"
			case "$2" in *:*) SSH_PORT="${2##*:}" ;; esac
			shift 2
			;;
		--port|--puerto)
			[ $# -ge 2 ] || { echo "usage: $0 --port <number>" >&2; exit 1; }
			PORT="$2"; NO_PROMPTS=1; shift 2
			;;
		--cert)
			[ $# -ge 2 ] || { echo "usage: $0 --cert <fullchain.pem>" >&2; exit 1; }
			CERT="$2"; NO_PROMPTS=1; shift 2
			;;
		--key|--clave)
			[ $# -ge 2 ] || { echo "usage: $0 --key <privkey.pem>" >&2; exit 1; }
			KEY="$2"; NO_PROMPTS=1; shift 2
			;;
		--remove|--quitar) REMOVE=1; shift ;;
		-h|--help) sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "I do not know what '$1' is" >&2; exit 1 ;;
	esac
done

red()  { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
gray()  { printf '\033[90m%s\033[0m\n' "$*"; }

# The answers are ALWAYS read from the terminal and never from standard input,
# which here may come from a pipe or from an ssh. If it cannot be read, it stops:
# going ahead assuming the answer is how the "yes" nobody
# said sneak in.
ask() {
	printf '%s' "$1" > /dev/tty || { red "cannot ask without a terminal"; exit 1; }
	IFS= read -r REPLY < /dev/tty || { echo; red "could not read the answer"; exit 1; }
}

yes_or_no() {
	_d="$2"
	while :; do
		if [ "$_d" = y ] || [ "$_d" = s ]; then ask "$1 [Y/n] "; else ask "$1 [y/N] "; fi
		case "${REPLY:-$_d}" in
			s|S|si|SI|Si|y|Y) return 0 ;;
			n|N|no|NO|No)     return 1 ;;
		esac
	done
}

# Runs something wherever it belongs: here or on the remote machine. A single function so
# there are not two paths that drift out of sync.
on_target() {
	if [ -n "$REMOTE" ]; then
		ssh -n -p "$SSH_PORT" "$REMOTE" "$@"
	else
		sh -c "$*"
	fi
}
copy_to_target() {
	if [ -n "$REMOTE" ]; then
		scp -q -P "$SSH_PORT" "$1" "$REMOTE:$2"
	else
		cp "$1" "$2"
	fi
}

WHERE="${REMOTE:-this machine}"

# --- undo it -----------------------------------------------------------------
#
# The DATA is not touched: the phone pairing and its last position live in
# /var/lib/lost-phone-relay, and deleting them would force pairing again. Whoever
# wants to leave for good deletes them by hand, and is told what the path is.
if [ -n "$REMOVE" ]; then
	echo
	echo "  Removing the relay from $WHERE..."
	on_target 'sudo systemctl disable --now lost-phone-relay' >/dev/null 2>&1 || true
	on_target 'sudo rm -f /etc/systemd/system/lost-phone-relay.service \
		/etc/systemd/system/lost-phone-relay.service.d/certificate.conf \
		/etc/systemd/system/lost-phone-relay.service.d/certificado.conf \
		/etc/letsencrypt/renewal-hooks/deploy/lost-phone-relay \
		/etc/lost-phone-relay.env
		sudo rmdir /etc/systemd/system/lost-phone-relay.service.d 2>/dev/null
		sudo rm -rf /opt/lost-phone-relay
		sudo systemctl daemon-reload' || true
	if [ "$(on_target 'systemctl is-active lost-phone-relay' 2>/dev/null || true)" = "active" ]; then
		red "  Still running. Check it by hand: systemctl status lost-phone-relay"
		exit 1
	fi
	green "  Removed."
	gray "  The data is still in /var/lib/lost-phone-relay (pairing and last position)."
	gray "  Delete it yourself if you want to leave for good: sudo rm -rf /var/lib/lost-phone-relay"
	exit 0
fi

echo
echo "  ══════════════════════════════════════════════════════════════════"
echo "   Set up the relay on: $WHERE"
echo "  ══════════════════════════════════════════════════════════════════"
echo
cat <<'END'
  The relay is the meeting point between your phone and the panel from which you
  look for it. It is needed because both are behind a NAT and neither can
  call the other: someone has to have a stable address, and that is this.

  It serves a page with the map, the phone's heartbeats and the buttons to make it
  ring, say where it is and lock it.

END

# --- 1. check that it can be done --------------------------------------------
if ! on_target 'command -v systemctl' >/dev/null 2>&1; then
	red "  That machine does not have systemd."
	gray "  Use the Docker path: LOST_PHONE_PASSWORD=... docker compose up -d"
	exit 1
fi
if ! on_target 'sudo -n true' >/dev/null 2>&1; then
	gray "  Note: root permissions will be needed there (sudo will ask for a password)."
fi

# --- 2. the binary, for ITS architecture -------------------------------------
ARCH="$(on_target 'uname -m' 2>/dev/null || echo unknown)"
case "$ARCH" in
	x86_64|amd64) GOARCH=amd64 ;;
	aarch64|arm64) GOARCH=arm64 ;;
	armv7l|armv6l) GOARCH=arm ;;
	*) red "  I do not know how to compile for '$ARCH'."; exit 1 ;;
esac
echo "  Compiling for $ARCH..."
( cd "$HERE" && GOOS=linux GOARCH="$GOARCH" ./build >/dev/null 2>&1 ) \
	|| { red "  Could not compile. Try './build' by hand to see the error."; exit 1; }
green "  Done."
echo

# --- 3. the port -------------------------------------------------------------
if [ -z "$PORT" ]; then
	ask "  On which port does it listen? [8477] "
	PORT="${REPLY:-8477}"
fi
case "$PORT" in
	''|*[!0-9]*) red "  '$PORT' is not a port."; exit 1 ;;
esac
if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
	red "  '$PORT' is not a port."; exit 1
fi

# --- 4. the certificate ------------------------------------------------------
cat <<'END'

  The relay speaks TLS and nothing else: as soon as you open the port, the panel
  password and the phone's token cross the internet.

  If you ALREADY have a certificate for the name you will reach it by, use it:
  the browser will not warn about anything. If not, one of its own is generated and you will have to
  accept an exception the first time (the phone keeps its fingerprint when
  pairing, so afterwards it only accepts that one).

END
if [ -z "$NO_PROMPTS" ] && yes_or_no "  Do you already have a certificate for that name?" n; then
	ask "  Path to the certificate (fullchain.pem): "
	CERT="$REPLY"
	ask "  Path to the private key (privkey.pem): "
	KEY="$REPLY"
fi
if [ -n "$CERT" ] || [ -n "$KEY" ]; then
	if [ -z "$CERT" ] || [ -z "$KEY" ]; then
		red "  The certificate and its key go together: one of the two is missing."
		exit 1
	fi
	if ! on_target "sudo test -r '$CERT' && sudo test -r '$KEY'"; then
		red "  I cannot find one of the two there. Check them and run me again."
		exit 1
	fi
fi

# --- 5. install --------------------------------------------------------------
PASS="$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24)"
echo
echo "  Installing..."

copy_to_target "$HERE/lost-phone-relay" /tmp/lost-phone-relay.bin
copy_to_target "$HERE/README.md" /tmp/lost-phone-relay.README

# The environment file, with the password. In a 600 file and not on the command
# line: anyone with access to the machine can read 'ps'.
on_target "sudo install -d -m755 /opt/lost-phone-relay \
	&& sudo install -m755 /tmp/lost-phone-relay.bin /opt/lost-phone-relay/lost-phone-relay \
	&& sudo install -m644 /tmp/lost-phone-relay.README /opt/lost-phone-relay/README.md \
	&& printf 'LOST_PHONE_PASSWORD=%s\nLOST_PHONE_ADDR=0.0.0.0:%s\n' '$PASS' '$PORT' \
	   | sudo tee /etc/lost-phone-relay.env >/dev/null \
	&& sudo chmod 600 /etc/lost-phone-relay.env"

copy_to_target "$HERE/lost-phone-relay.service" /tmp/lost-phone-relay.service
on_target "sudo install -m644 /tmp/lost-phone-relay.service /etc/systemd/system/"

if [ -n "$CERT" ]; then
	# LoadCredential and not the bare path: the service runs with DynamicUser and
	# cannot read a private key owned by root. systemd reads it itself and hands it
	# only to this process, without loosening anyone's permissions.
	on_target "sudo install -d -m755 /etc/systemd/system/lost-phone-relay.service.d \
		&& printf '[Service]\nLoadCredential=cert:%s\nLoadCredential=key:%s\nEnvironment=LOST_PHONE_CERT=%%d/cert\nEnvironment=LOST_PHONE_KEY=%%d/key\n' \
		   '$CERT' '$KEY' \
		   | sudo tee /etc/systemd/system/lost-phone-relay.service.d/certificate.conf >/dev/null"

	# And the renewal hook, if this is Let's Encrypt: the credentials are
	# read AT STARTUP, so a renewed certificate does not arrive on its own. Without this
	# the relay would serve the old one until it expires, and the browser would warn again
	# months later without anyone remembering why.
	case "$CERT" in
		/etc/letsencrypt/*)
			LINEAGE="$(dirname "$CERT")"
			on_target "sudo install -d -m755 /etc/letsencrypt/renewal-hooks/deploy \
				&& printf '#!/bin/sh\n# Certbot renewed: systemd credentials are read at startup.\ncase \"\\\$RENEWED_LINEAGE\" in\n\t%s) systemctl restart lost-phone-relay ;;\nesac\n' '$LINEAGE' \
				   | sudo tee /etc/letsencrypt/renewal-hooks/deploy/lost-phone-relay >/dev/null \
				&& sudo chmod 755 /etc/letsencrypt/renewal-hooks/deploy/lost-phone-relay"
			gray "  certbot renewal hook installed."
			;;
	esac
fi

on_target "sudo systemctl daemon-reload && sudo systemctl enable --now lost-phone-relay" >/dev/null 2>&1 || true
sleep 3

if [ "$(on_target 'systemctl is-active lost-phone-relay' 2>/dev/null || true)" != "active" ]; then
	red "  It did not start. What it says about itself:"
	on_target 'sudo journalctl -u lost-phone-relay -n 15 --no-pager -o cat' || true
	exit 1
fi
green "  Started."

# --- 6. say what to do with this ---------------------------------------------
IP="$(on_target "ip -4 -o addr show scope global | awk '{print \$4}' | cut -d/ -f1 | head -1" 2>/dev/null || true)"
echo
echo "  ══════════════════════════════════════════════════════════════════"
echo "   Done. Write this down, the password is not shown again:"
echo "  ══════════════════════════════════════════════════════════════════"
echo
echo "     Panel:       https://${IP:-<the-ip-of-that-machine>}:$PORT"
echo "     Password:    $PASS"
echo
cat <<END
  To pair the phone:

    1. Open the panel, log in and press "Generate code".
    2. On the phone, under "Find the phone" > "Your server", paste the address and
       type the four numbers. Or from your computer:
           surya/setup/configure-search

  What I did NOT touch, and you decide:

    - Your DNS. If you are going to reach it from outside home, point it at a NAME and
      not at an IP: a home IP changes, and the day it changes the phone will stop
      finding the relay SILENTLY, months later and with nothing warning you.
    - The port $PORT on your router, if you want it reachable from the street.
    - No subdomains: the root domain with the port is enough.

END
if [ -z "$CERT" ]; then
	gray "  Own certificate: the browser will warn the first time. Compare the"
	gray "  fingerprint with the one that appears in the log:"
	gray "      sudo journalctl -u lost-phone-relay | grep -A1 Fingerprint"
	echo
fi
